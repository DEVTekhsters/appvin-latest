---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Industries from '../components/Industries.astro';
import CaseStudies from '../components/CaseStudies.astro';
import Clients from '../components/Clients.astro';
import Testimonials from '../components/Testimonials.astro';
import BlogPreview from '../components/BlogPreview.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Top-Rated Software Development & Custom AI Services | AppVin"
  description="A leading AI-powered software development company with 120+ completed projects. Transform your business with scalable custom software and AI-native solutions."
>
  <Fragment slot="head">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="https://appvintech.com/" />
    <!-- Include the Cookie Banner Bundle from S3 -->
    <script src="https://d1axzsitviir9s.cloudfront.net/gotrust-consent-shim.v1.0.0.min.js" data-safe="true"></script>
    <script src="https://d1axzsitviir9s.cloudfront.net/cookie-banner.bundle.js" data-safe="true"></script>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Corporation",
        "name": "AppVin Technologies",
        "url": "https://appvintech.com/",
        "logo": "https://appvintech.com/images/appvin-logo.png",
        "contactPoint": {
          "@type": "ContactPoint",
          "telephone": "+31 611306856",
          "contactType": "sales",
          "areaServed": ["NL", "US", "GB", "AE", "IN"]
        },
        "sameAs": "https://linkedin.com/company/appvin"
      }
    </script>
  </Fragment>
  <Header />

  <main>
    <!-- Embed the Cookie Banner -->
    <div id="gotrust-cookie-banner"></div>

    <script is:inline>
      (function () {
        function ready(fn) {
          if (document.readyState !== 'loading') fn();
          else document.addEventListener('DOMContentLoaded', fn);
        }

        function tryInit() {
          if (!window.CookieBanner || typeof window.CookieBanner.init !== 'function') {
            return false;
          }

          var el = document.querySelector('#gotrust-cookie-banner');
          if (!el) return false;

          if (el.__gotrustMounted) return true;

          var respectDNT = (navigator.doNotTrack === '1' || navigator.doNotTrack === 'yes');

          window.CookieBanner.init('#gotrust-cookie-banner', {
            domainUrl: 'https://appvintech.com/',
            environment: 'https://sandbox.gotrust.tech',
            domain_id: '244',
          });
          return true;
        }

        ready(function () {
          if (tryInit()) return;

          function onReady() { if (tryInit()) window.removeEventListener('CookieBannerReady', onReady); }
          window.addEventListener('CookieBannerReady', onReady);

          var attempts = 0;
          var t = setInterval(function () {
            attempts++;
            if (tryInit() || attempts > 20) clearInterval(t);
          }, 100);
        });
      })();
    </script>

    <Hero />
    <Services />
    <Industries />
    <CaseStudies />
    <Clients />
    <Testimonials />
    <BlogPreview />
    <Contact />
  </main>

  <Footer />
</Layout>
