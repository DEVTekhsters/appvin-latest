<script define:vars={{ PUBLIC_API_URL }}>
  window.__NEWSLETTER_API_BASE__ = PUBLIC_API_URL;
</script>
<script is:inline>
  // Newsletter form submission
  document.addEventListener("DOMContentLoaded", () => {
    // Newsletter form handling
    const newsletterForm = document.getElementById("newsletter-form");
    const newsletterSuccess = document.getElementById("newsletter-success");
    const newsletterError = document.getElementById("newsletter-error");

    if (newsletterForm && newsletterForm instanceof HTMLFormElement) {
      const submitBtn = newsletterForm.querySelector('button[type="submit"]');
      const originalBtnHTML = submitBtn ? submitBtn.innerHTML : "";
      newsletterForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        const formData = new FormData(newsletterForm);
        const data = Object.fromEntries(formData.entries());
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.innerHTML = "Sending...";
        }
        newsletterForm.classList.add("opacity-75", "pointer-events-none");
        if (newsletterSuccess) newsletterSuccess.classList.add("hidden");
        if (newsletterError) newsletterError.classList.add("hidden");
        try {
          const apiBase = window.__NEWSLETTER_API_BASE__;
          const apiUrl = apiBase
            ? apiBase + "/api/newsletter"
            : "/api/newsletter";
          const res = await fetch(apiUrl, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(data),
          });
          if (res.ok) {
            if (newsletterSuccess) newsletterSuccess.classList.remove("hidden");
            newsletterForm.reset();
            setTimeout(() => {
              if (newsletterSuccess) newsletterSuccess.classList.add("hidden");
            }, 5000);
          } else {
            const text = await res.text();
            console.error("Newsletter error:", text);
            if (newsletterError) newsletterError.classList.remove("hidden");
            setTimeout(() => {
              if (newsletterError) newsletterError.classList.add("hidden");
            }, 4000);
          }
        } catch (err) {
          console.error("Newsletter request failed:", err);
          if (newsletterError) newsletterError.classList.remove("hidden");
          setTimeout(() => {
            if (newsletterError) newsletterError.classList.add("hidden");
          }, 4000);
        } finally {
          newsletterForm.classList.remove("opacity-75", "pointer-events-none");
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalBtnHTML;
          }
        }
      });
    }

    const dsrFormTrigger = document.getElementById("dsr-form-trigger");

    if (dsrFormTrigger) {
      dsrFormTrigger.addEventListener("click", () => {
        const existingScript = document.querySelector(
          'script[data-dsr-widget="true"]',
        );

        if (existingScript) {
          existingScript.remove();
        }

        const dsrScript = document.createElement("script");
        dsrScript.src = "https://dev.gotrust.tech/dsr-widget.js";
        dsrScript.setAttribute(
          "collectionId",
          "U2FsdGVkX18URE7-zQazZ0M-4ShXRYgpRRrW7CX4IHA_",
        );
        dsrScript.setAttribute(
          "businessUnitId",
          "U2FsdGVkX1-FFxFnPqo9plTxfRt5aR-K1GPor21Lddy-0lbJk_",
        );
        dsrScript.setAttribute(
          "environment",
          "https://dev.gotrust.tech/backend",
        );
        dsrScript.setAttribute("data-dsr-widget", "true");
        document.body.appendChild(dsrScript);
      });
    }

    // Back to top functionality
    const backToTopButton = document.getElementById("back-to-top");

    if (backToTopButton) {
      backToTopButton.addEventListener("click", () => {
        window.scrollTo({
          top: 0,
          behavior: "smooth",
        });
      });

      // Show/hide back to top button based on scroll position
      window.addEventListener("scroll", () => {
        if (window.scrollY > 500) {
          backToTopButton.classList.add("opacity-100");
          backToTopButton.classList.remove("opacity-0");
        } else {
          backToTopButton.classList.add("opacity-0");
          backToTopButton.classList.remove("opacity-100");
        }
      });
    }

    // Office location cards hover effect is now handled by CSS classes
    // No JavaScript needed for the hover effect anymore
  });
</script>

