---
import MultiStepForm from './MultiStepForm.astro';
---

<section id="contact" class="py-20 bg-white dark:bg-gray-900">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <!-- Contact Information -->
        <div class="animate-in fade-in slide-in-from-left-5 duration-500">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6">
            <span class="gradient-text">Accelerate</span> Your Business Growth
          </h2>

          <p class="text-lg text-gray-600 dark:text-gray-400 mb-8 max-w-md">
            Ready to achieve measurable business outcomes? Our AI solutions deliver an average 3.5x ROI within 12 months. Let's discuss your specific challenges.
          </p>

          <!-- Office Address Section - Reverted to Original State -->
          <div class="office-address mt-8">
            <h3 class="text-xl font-bold mb-2">Our Office</h3>
            <p class="text-gray-600 dark:text-gray-300">
              Kanaalpark 140, 2341 JV, Leiden, Netherlands
            </p>
            <p class="text-gray-600 dark:text-gray-300">
              Phone: <a href="tel:+31611306856" class="underline hover:text-primary-600">+31 6 11 30 68 56</a>
            </p>
            <p class="text-gray-600 dark:text-gray-300">
              Email: <a href="mailto:info@appvintech.com" class="underline hover:text-primary-600">info@appvintech.com</a>
            </p>
          </div>
        </div>

        <!-- Multi-Step Contact Form -->
        <div class="animate-in fade-in slide-in-from-right-5 duration-500 delay-150">
          <MultiStepForm />
        </div>
      </div>
    </div>
  </div>
</section>
